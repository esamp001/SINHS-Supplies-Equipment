# Copy this file to .env and fill in your values. Never commit .env.

PORT=4000
NODE_ENV=development
TZ=Asia/Manila

# PostgreSQL (local install). Create the database first: CREATE DATABASE sinhs_inventory;
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_postgres_password
DB_NAME=sinhs_inventory

# Auth cookie / JWT. Use a long random string for JWT_SECRET.
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=7d
COOKIE_NAME=sinhs_token
# true only when served over HTTPS
COOKIE_SECURE=false

# Vite dev server URL (only needed if the client calls the API directly instead of through the Vite proxy)
CORS_ORIGIN=http://localhost:5173

# Password for the seeded demo accounts (admin, custodian, staff). Hashed with bcrypt when seeding.
SEED_DEFAULT_PASSWORD=password123
